{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "seed:designation": "node ./src/seeders/designation.js",
    "seed:admin": "node ./src/seeders/admin.js",
    "seed:all": "npm run seed:designation && npm run seed:admin",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migration:run": "npx sequelize-cli db:migrate",
    "migration:undo": "npx sequelize-cli db:migrate:undo:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "debug": "~4.4.3",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0",
    "ejs": "~6.0.1",
    "express": "~5.2.1",
    "express-fileupload": "^1.5.2",
    "express-session": "^1.19.0",
    "fs": "^0.0.1-security",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.2.0",
    "joi": "^18.2.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "morgan": "~1.10.1",
    "node-cron": "^4.4.1",
    "nodemailer": "^8.0.9",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "redis": "^6.0.0",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "sequelize-cli": "^6.6.5"
  }
}
