<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify Your Email</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap');
    
    body {
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
      margin: 0;
      padding: 0;
      color: #1e293b;
    }
    .wrapper {
      padding: 40px 20px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .container {
      max-width: 550px;
      width: 100%;
      background: rgba(255, 255, 255, 0.98);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
      margin: 0 auto;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 40px 30px;
      text-align: center;
      color: #ffffff;
    }
    .header h1 {
      margin: 0;
      font-size: 28px;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .content {
      padding: 40px 30px;
      text-align: center;
      background: #ffffff;
    }
    .content p {
      font-size: 16px;
      line-height: 1.7;
      color: #475569;
      margin-bottom: 24px;
    }
    .otp-wrapper {
      margin: 30px 0;
    }
    .otp-box {
      display: inline-block;
      background: linear-gradient(to right, #f8fafc, #f1f5f9);
      padding: 20px 40px;
      border-radius: 12px;
      font-size: 38px;
      font-weight: 700;
      letter-spacing: 8px;
      color: #764ba2;
      border: 2px dashed #cbd5e1;
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }
    .highlight {
      color: #0f172a;
      font-weight: 600;
    }
    .footer {
      background-color: #f8fafc;
      padding: 24px;
      text-align: center;
      font-size: 13px;
      color: #64748b;
      border-top: 1px solid #e2e8f0;
    }
    .footer p {
      margin: 6px 0;
    }
    .support-link {
      color: #667eea;
      text-decoration: none;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>Verify Your Email</h1>
      </div>
      <div class="content">
        <p>Welcome aboard, <span class="highlight"><%= name %></span>!</p>
        <p>We're excited to have you. To complete your registration and ensure the security of your account, please verify your email using the One-Time Password (OTP) below.</p>
        
        <div class="otp-wrapper">
          <div class="otp-box">
            <%= otp %>
          </div>
        </div>
        
        <p>This verification code expires in <span class="highlight"><%= expireHours %> hours</span>.</p>
        <p style="font-size: 14px; color: #94a3b8;">If you did not sign up for this account, please disregard this email.</p>
      </div>
      <div class="footer">
        <p>&copy; <%= new Date().getFullYear() %> Truck Management System. All rights reserved.</p>
        <p>Need assistance? Contact our <a href="<%= baseurl %>/support" class="support-link">support team</a>.</p>
      </div>
    </div>
  </div>
</body>
</html>
